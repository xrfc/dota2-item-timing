    {
      "name": "chaos_knight_phantasm",
      "id": 5429,
      "name_zh": "混沌之军",
      "name_en": "Phantasm",
      "description_zh": "从其他维度召唤若干个混沌骑士的幻象。幻象继承%outgoing_damage_tooltip%%%攻击力，但是承受%incoming_damage_tooltip%%%伤害。\n驱散类型：弱驱散",
      "description_en": "Summons several phantasmal copies of the Chaos Knight from alternate dimensions. The phantasms are illusions that deal %outgoing_damage_tooltip%%% damage, but take %incoming_damage_tooltip%%% damage.\nDISPEL TYPE: Basic Dispel",
      "notes_zh": [
        "能够移除混沌骑士的大部分负面状态。",
        "混沌骑士在施放时有%invuln_duration%秒的无敌时间，可以躲避眩晕和伤害技能。"
      ],
      "notes_en": [
        "Removes most negative buffs from Chaos Knight.",
        "Chaos Knight is invulnerable for %invuln_duration% seconds when casting, allowing him to dodge stuns and damage."
      ],
      "source_collection": "abilities",
      "source_pointer": "/result/data/heroes/0/abilities/4",
      "innate": false,
      "granted_by_scepter": false,
      "granted_by_shard": false,
