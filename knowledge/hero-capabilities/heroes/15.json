    {
      "name": "razor_static_link",
      "id": 5083,
      "name_zh": "静电连接",
      "name_en": "Static Link",
      "description_zh": "在雷泽和敌方英雄之间创造静电连接，偷取目标的攻击力并转移给雷泽。雷泽在连接生效时可以边移动边攻击。",
      "description_en": "Creates a charged link between Razor and an enemy Hero, stealing damage from the target and giving it to Razor. Allows Razor to attack while moving with the link active.",
      "notes_zh": [
        "链接在一方单位死亡或双方距离超过%drain_range_buffer%后断裂。"
      ],
      "notes_en": [
        "The link is broken when either unit dies or the distance between them becomes %drain_range_buffer% units greater than Static Link's cast range."
      ],
