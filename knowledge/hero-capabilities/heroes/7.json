    {
      "name": "earthshaker_fissure",
      "id": 5023,
      "name_zh": "沟壑",
      "name_en": "Fissure",
      "description_zh": "用威武的图腾猛击地面，沿直线裂开地面，制造一条无法通过的岩脊，对沿途的敌方单位造成眩晕和伤害。",
      "description_en": "Slams the ground with a mighty totem, creating an impassable ridge of stone while stunning and damaging enemy units along its line.",
      "notes_zh": [
        "小兵将会等待沟壑消失，不会去尝试绕开它。",
        "沟壑不会被林肯法球抵挡。"
      ],
      "notes_en": [
        "Creeps will wait for Fissure to disappear. They will not attempt to walk around it.",
        "Fissure is not blocked by Linken's Sphere."
      ],
      "source_collection": "abilities",
      "source_pointer": "/result/data/heroes/0/abilities/0",
      "innate": false,
      "granted_by_scepter": false,
      "granted_by_shard": false,
      "upgrade_text": {
        "scepter_loc": {
          "en": "",
          "zh": ""
        },
        "shard_loc": {
          "en": "Reduces Fissure cooldown and releases an Aftershock along its path that stuns for a shortened duration when Earthshaker casts another ability.",
          "zh": "降低沟壑的冷却时间，并且撼地者每次施放其他技能时都会沿着沟壑释放余震，造成眩晕的时间有所降低。"
        }
      },
      "facet_text_en": [
        "",
        "",
        "Enemy heroes stunned by Fissure emit an echo to each nearby unit within a %echoes_radius% radius, dealing damage equal to %echoes_damage_multiplier%%% of Echo Slam's current echo damage."
