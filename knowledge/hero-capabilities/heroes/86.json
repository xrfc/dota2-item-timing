    {
      "name": "rubick_spell_steal",
      "id": 5452,
      "name_zh": "技能窃取",
      "name_en": "Spell Steal",
      "description_zh": "拉比克钻研一个敌方英雄的魔法精华之痕，学习这个英雄最后释放的技能的秘密。拉比克将可以使用这个技能，维持几分钟或直到他死亡。",
      "description_en": "Rubick studies the trace magical essence of one enemy hero, learning the secrets of the last spell the hero cast. Rubick can use this spell as his own for several minutes or until he dies.",
      "notes_zh": [
        "无法窃取物品类技能。",
        "拉比克若拥有阿哈利姆魔晶，则窃取的技能会是魔晶升级版本。",
        "不会触发法术反弹。"
      ],
      "notes_en": [
        "Cannot steal item abilities.",
        "Rubick will steal the Aghanim's Shard version of the ability, if he himself has an Aghanim's Shard.",
        "Does not trigger spell reflect."
      ],
      "source_collection": "abilities",
      "source_pointer": "/result/data/heroes/0/abilities/3",
      "innate": false,
      "granted_by_scepter": false,
      "granted_by_shard": false,
      "upgrade_text": {
        "scepter_loc": {
          "en": "Increases the number of spells that can be stolen to 2. Increases cast range, and upgrades stolen spells to their Scepter version.",
          "zh": "可窃取的技能提升至2个。提升施法距离，并且窃取的技能会升级成神杖版本。"
        },
        "shard_loc": {
          "en": "Upgrades stolen spells to their Shard version.",
          "zh": "窃取的技能升级为相应的魔晶版本。"
        }
      },
      "facet_text_en": [
        "Stolen spells also have lower mana cost.",
        ""
      ],
      "facet_text_zh": [
        "窃取技能的魔法消耗也会降低。",
